---
import { Button } from "@/components/ui/button";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Profile from "../assets/bluelado.png";

const button = [
  {
    label: "My Portfolio",
    link: "https://ifalf.com",
    useFavicon: true,
  },
  {
    label: "Resource Tutorial Web AI",
    link: "https://docs.google.com/document/d/1c6NEPRKAZFTnDGxwY_9pWulwRj3_xaqIA9Xxb1HTDcw/edit?usp=sharing",
    useFavicon: true
  },
  {
    label: "Prompt Pack Ultimate", 
    link: "https://lynk.id/ifalf/3olxynx37xww", 
    useFavicon: true
  },
  {
    label: "Source Code Pack", 
    link: "https://lynk.id/ifalf/v2rwzkr5mg6r", 
    useFavicon: true
  },
    {
    label: "Prompt Pack Basic", 
    link: "https://lynk.id/ifalf/", 
    useFavicon: true
  },
  {
    label: "n8n Resource",
    link: "/n8n-resources",
    icon: "https://n8n.io/favicon.ico"
  },
  {
    label: "Daftar ClawCloud Run",
    link: "https://console.run.claw.cloud/signin?link=VQNU9IHE49T6",
    useFavicon: true,
  },
  {
    label: "Roasting HP",
    link: "https://roastinghp.vercel.app",
    useFavicon: true,
  },
  {
    label: "Keluh Kesah",
    link: "https://keluhkesah.vercel.app",
    useFavicon: true,
  },
];

const social = [
  { icon: "ri:facebook-fill", link: "https://facebook.com/aldo.fiondhy" },
  { icon: "ri:instagram-fill", link: "https://instagram.com/aldofiond" },
  { icon: "ri:linkedin-fill", link: "https://linkedin.com/in/ifalfahri" },
  { icon: "ri:tiktok-fill", link: "https://tiktok.com/aldofiondhy" },
  { icon: "ri:whatsapp-fill", link: "https://wa.me/6285656969189" },
];
---

<main
  id="container"
  class="mx-auto justify-center items-center flex max-w-screen-sm min-h-screen container flex-col space-y-6 p-10"
>
  <div>
    <Image
      src={Profile}
      alt="profile-picture"
      class="mb-4 mx-auto rounded-full w-20 border-border border-2 shadow-shadow hover:translate-x-boxShadowX hover:translate-y-boxShadowY hover:shadow-none"
    />
    <h1 class="text-3xl text-center font-heading">IfalEX</h1>
    <p class="text-center text-base">Web Developer - UI/UX - Tech Enthusiast</p>
  </div>
  <div class="space-y-10">
    <div class="flex space-x-4 justify-center">
      {
        social.map(({ link, icon }) => (
          <a href={link}>
            <Button className="w-12 h-12" size="icon">
              <Icon name={icon} />
            </Button>
          </a>
        ))
      }
    </div>
    <div class="flex flex-col space-y-4">
      {
        button.map(({ label, link, icon, useFavicon }) => {
          const iconSrc =
            icon ||
            (useFavicon
              ? `https://www.google.com/s2/favicons?domain=${link}&sz=32`
              : null);

          return (
            <a href={link}>
              <Button
                className="w-96 h-14 text-base font-semibold flex items-center gap-3"
                size="lg"
              >
                {iconSrc && (
                  <img src={iconSrc} alt={`${label} favicon`} class="w-5 h-5" />
                )}
                {label}
              </Button>
            </a>
          );
        })
      }
    </div>
  </div>
</main>
